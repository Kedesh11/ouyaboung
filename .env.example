# ============================================
# Ouyaboung - Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# --- Application ---
NEXT_PUBLIC_APP_URL=https://ouyaboung-eight.vercel.app
APP_URL=https://ouyaboung-eight.vercel.app
NODE_ENV=development

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Analytics & Intelligence (server-side) ---
ANALYTICS_EXPORT_KEY=optional-export-key
INTELLIGENCE_API_KEY=optional-intelligence-write-key

# --- Q-Gabon / Mobile Money payments (server-side) ---
ACCOUNT_CODE=
ACCOUNT_CODE_MOOV=
AGENT=AG001
BEAR_TOKEN=
QGABON_WEBHOOK_SECRET=
# Development only. Never set to true in production.
ALLOW_INSECURE_WEBHOOKS=false

# --- Rate limiting (optional, recommended in production) ---
# Uses Upstash Redis REST API when configured; falls back to in-memory otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email / SMTP (server-side notifications) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Ouyaboung

# --- Debug flags (optional) ---
NEXT_PUBLIC_AUTH_DEBUG=false
NEXT_PUBLIC_SUPABASE_DEBUG=false
NEXT_PUBLIC_WEB_VITALS_DEBUG=false
NEXT_PUBLIC_TRACKING_FLUSH_INTERVAL_MS=10000
