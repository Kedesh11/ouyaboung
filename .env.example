# ============================================
# Ouyaboung - Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# --- Application ---
NEXT_PUBLIC_APP_URL=https://ouyaboung-eight.vercel.app
APP_URL=https://ouyaboung-eight.vercel.app
NODE_ENV=development

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Analytics & Intelligence (server-side) ---
ANALYTICS_EXPORT_KEY=optional-export-key
INTELLIGENCE_API_KEY=optional-intelligence-write-key

# --- Payments: PVIT Mobile Money (server-side, Edge Function secrets) ---
# The payment flow stays OFF in the app until the PVIT Edge Functions are
# deployed and tested. Set these as Supabase secrets (`supabase secrets set`),
# never in client code. Guide: docs/PVIT_INTEGRATION.md
NEXT_PUBLIC_PAYMENT_FLOW_ENABLED=false
PVIT_BASE_URL=https://api.mypvit.pro
# Ouyaboung operation account (ACC_...) that collects payments and splits them
PVIT_OPERATION_ACCOUNT_CODE=
# Password defined in the PVIT merchant space (menu APIs) for secret renewal
PVIT_SECRET_PASSWORD=
# "Code URL" of each PVIT API (merchant space > APIs)
PVIT_CODE_URL_SECRET=
PVIT_CODE_URL_PAYMENT=
PVIT_CODE_URL_STATUS=
PVIT_CODE_URL_KYC=
# Code of the registered callback URL (merchant space > Urls), which must point
# to https://<project-ref>.supabase.co/functions/v1/pvit-callback
PVIT_CALLBACK_URL_CODE=
# Who bears PVIT's fees: MERCHANT (platform, default) or CUSTOMER
PVIT_OWNER_CHARGE=MERCHANT
# Webhook source check: report (log only, default) | enforce (reject) | off
PVIT_CALLBACK_IP_MODE=report
# Addresses PVIT calls the webhook from (comma separated). Required for
# `enforce`: with an empty list, enforce rejects every callback (fail closed).
PVIT_CALLBACK_ALLOWED_IPS=176.31.65.18,176.31.65.20,176.31.65.21,13.59.249.167
# Platform commission kept on every payment (0.10 = 10%). REQUIRED: there is no
# default, payments are refused (503) while it is missing or invalid.
PLATFORM_COMMISSION_RATE=0.10
# Payment limits (optional, defaults shown)
PAYMENT_MAX_INITIATIONS_PER_WINDOW=5
PAYMENT_INITIATION_WINDOW_MINUTES=10
PAYMENT_IN_FLIGHT_WINDOW_MINUTES=5
# Origins allowed to call the payment functions from a browser (CORS, comma
# separated). Unset = any origin (local development only).
ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:3000

# --- Map & drivers (optional, defaults shown) ---
# Basemap style used by every map. Unset = Carto Positron.
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# Driver live-position cadence: minimum interval between two sends (ms), heartbeat of a stationary
# driver (ms, must stay well under 2 minutes), minimum movement (m), and the farmer map refresh (ms).
# NEXT_PUBLIC_DRIVER_PUBLISH_INTERVAL_MS=8000
# NEXT_PUBLIC_DRIVER_HEARTBEAT_MS=30000
# NEXT_PUBLIC_DRIVER_MIN_MOVE_M=15
# NEXT_PUBLIC_DRIVER_MAP_POLL_MS=5000
# Rafraichissement des demandes de transport (agriculteur) et des courses (chauffeur), en ms.
# NEXT_PUBLIC_TRANSPORT_POLL_MS=5000

# --- Application (public) ---
# Public site URL (SEO, absolute links, emails). Required in production.
# NEXT_PUBLIC_APP_URL is set above. Contact addresses shown in the UI:
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Supabase Edge Functions aliases, required server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Rate limiting (optional, recommended in production) ---
# Uses Upstash Redis REST API when configured; falls back to in-memory otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email / SMTP (server-side notifications) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Ouyaboung

# --- Error monitoring (optional, recommended in production) ---
# Sentry.init() is disabled automatically when these are unset, so the app
# runs unchanged until a Sentry project/DSN is created.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
# Only needed to upload source maps at build time; safe to leave empty.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Debug flags (optional) ---
NEXT_PUBLIC_AUTH_DEBUG=false
NEXT_PUBLIC_SUPABASE_DEBUG=false
NEXT_PUBLIC_WEB_VITALS_DEBUG=false
NEXT_PUBLIC_TRACKING_FLUSH_INTERVAL_MS=10000
