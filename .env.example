# ============================================
# Environment Variables - Ouyaboung Platform
# ============================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: server-side Supabase variables (if needed by scripts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Server-side email provider key (do not expose in public env vars)
RESEND_API_KEY=re_your_resend_api_key

# SMTP configuration (if using SMTP instead of Resend)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SENDER_EMAIL=no-reply@your-domain.com
SMTP_SENDER_NAME=Ouyaboung
SMTP_MIN_INTERVAL_SECONDS=60

# Payment provider values (if enabled)
BEAR_TOKEN=your_payment_bearer_token
ACCOUNT_CODE=your_airtel_account_code
ACCOUNT_CODE_MOOV=your_moov_account_code
PODUCT=paiement
AGENT=your_agent_name
