# ============================================
# Ouyaboung - Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# --- Application ---
NEXT_PUBLIC_APP_URL=https://ouyaboung-eight.vercel.app
APP_URL=https://ouyaboung-eight.vercel.app
NODE_ENV=development

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Analytics & Intelligence (server-side) ---
ANALYTICS_EXPORT_KEY=optional-export-key
INTELLIGENCE_API_KEY=optional-intelligence-write-key

# --- Q-Gabon / Mobile Money payments (server-side) ---
# Current implementation uses platform-level credentials.
# Target SingPay architecture uses one platform wallet plus dynamic payouts:
# docs/PAYMENT_MULTI_TENANT_ARCHITECTURE.md
ACCOUNT_CODE=
ACCOUNT_CODE_MOOV=
AGENT=AG001
BEAR_TOKEN=
QGABON_WEBHOOK_SECRET=
# Development only. Never set to true in production.
ALLOW_INSECURE_WEBHOOKS=false

# --- SingPay payments (target multi-tenant provider, server-side) ---
# Not wired in the current code yet. The future implementation must use the
# platform wallet server-side and resolve payout recipients from verified
# merchant/admin mobile money numbers, never from the client.
# docs/SINGPAY_SWAGGER_ANALYSIS.md
SINGPAY_BASE_URL=https://gateway.singpay.ga/v1
SINGPAY_PLATFORM_WALLET_ID=
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_CALLBACK_SECRET=
SINGPAY_TRANSFERS_ENABLED=false
SINGPAY_REQUIRE_VERIFIED_PAYOUT=true
SINGPAY_PAYMENT_DISBURSEMENT_MODE=deferred
PLATFORM_COMMISSION_RATE=0.10

# Supabase Edge Functions aliases, required server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Rate limiting (optional, recommended in production) ---
# Uses Upstash Redis REST API when configured; falls back to in-memory otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email / SMTP (server-side notifications) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Ouyaboung

# --- Error monitoring (optional, recommended in production) ---
# Sentry.init() is disabled automatically when these are unset, so the app
# runs unchanged until a Sentry project/DSN is created.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
# Only needed to upload source maps at build time; safe to leave empty.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Debug flags (optional) ---
NEXT_PUBLIC_AUTH_DEBUG=false
NEXT_PUBLIC_SUPABASE_DEBUG=false
NEXT_PUBLIC_WEB_VITALS_DEBUG=false
NEXT_PUBLIC_TRACKING_FLUSH_INTERVAL_MS=10000
